# Copy to .env to enable local features. All are optional for `npm run build`.

# Public link to your Google Form — enables the "🍪 Log a snack day" button.
VITE_SNACK_FORM_URL=https://forms.gle/YOUR-FORM-ID

# Published Google Sheet CSV. Used by the snack sync:
#   node --env-file=.env scripts/fetch-snacks.mjs
SNACK_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?output=csv
