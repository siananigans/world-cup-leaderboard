# Copy to .env to enable the "Log a snack day" button locally.
# This is the public link to your Google Form. When unset, the button is hidden.
VITE_SNACK_FORM_URL=https://forms.gle/YOUR-FORM-ID

# Used by `npm run snacks` to pull snack tallies from the published Google Sheet
# CSV (File → Share → Publish to web → CSV). Not needed for the site to build.
# SNACK_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?output=csv
